{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "chat-api",
    "Audience": "chat-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "CodeMinutes": 15,
    "CodeMaxAttempts": 5,
    "ResendCooldownSeconds": 60
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "From": "no-reply@chat.local"
  }
}
